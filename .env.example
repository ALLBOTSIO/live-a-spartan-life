# Live a Spartan Life — environment
# Copy to .env.local and fill in. Never commit real keys.

# Public site URL. Used for canonical URLs, OG tags, sitemap, Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Auth + Postgres) ------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Brotherhood subscription) -----------------------------------
STRIPE_SECRET_KEY=
# Price ID for the $24/mo recurring price (starts with price_).
STRIPE_BROTHERHOOD_PRICE_ID=
# From the webhook endpoint you create for /api/stripe/webhook (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional + newsletter email) ---------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="JROC <jroc@liveaspartanlife.com>"
# Optional: Resend Audience for the newsletter list.
RESEND_AUDIENCE_ID=

# --- PostHog (analytics) --------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature flags --------------------------------------------------------
# Global scanline texture overlay. Set to "false" to turn it off.
NEXT_PUBLIC_FEATURE_SCANLINE=true
